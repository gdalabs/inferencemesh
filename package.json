{
  "name": "inferencemesh",
  "version": "0.1.0",
  "description": "OpenAI-compatible router that picks an LLM provider per request by cost, capability, language, privacy, quota and health.",
  "type": "module",
  "license": "MIT",
  "author": "GDA Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdalabs/inferencemesh.git"
  },
  "keywords": [
    "llm",
    "router",
    "openai-compatible",
    "byok",
    "fallback",
    "groq",
    "gemini",
    "openrouter",
    "cloudflare-workers"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./server": "./dist/src/server/node.js"
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "inferencemesh": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/providers.default.json",
    "providers.default.json",
    "providers.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "serve": "npm run build && node dist/src/server/node.js",
    "probe": "npm run build && node dist/src/cli.js probe",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/bundle.cjs",
    "build:binary": "npm run build && npm run bundle && node --experimental-sea-config sea-config.json && cp \"$(command -v node)\" build/inferencemesh && postject build/inferencemesh NODE_SEA_BLOB build/sea-prep.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.0"
  }
}
