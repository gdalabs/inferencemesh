# BYOK — set only the providers you actually have.
# A provider whose key is missing is skipped at load time and reported in /healthz.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Gateway. Comma-separated. The server refuses to start if this is empty.
INFERENCEMESH_TOKENS=
INFERENCEMESH_PORT=8910
INFERENCEMESH_HOST=127.0.0.1
# Comma-separated origins allowed to call from a browser. Empty = no CORS headers.
INFERENCEMESH_ALLOWED_ORIGINS=
# Path to your own registry file. Defaults to the bundled free-tier registry.
INFERENCEMESH_REGISTRY=
